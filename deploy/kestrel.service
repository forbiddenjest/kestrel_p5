[Unit]
Description=Kestrel web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kestrel
Group=kestrel
WorkingDirectory=/opt/kestrel
EnvironmentFile=/etc/kestrel/kestrel.env
ExecStart=/opt/kestrel/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kestrel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
